# Akiya Scout Environment Configuration
# Copy this file to .env and fill in the values

# Application settings
APP_NAME=Akiya Scout
APP_VERSION=0.1.0
DEBUG=false
HOST=0.0.0.0
PORT=8000

# SSL/TLS (default: secure - do NOT allow insecure SSL in production)
AKIYA_ALLOW_INSECURE_SSL=false

# Cache (default: 10 minutes)
CACHE_TTL_SECONDS=600

# Rate limiting (default: 1 second between requests)
RATE_LIMIT_DELAY=1.0

# Timeouts (seconds)
REQUEST_TIMEOUT=30
IMAGE_TIMEOUT=5